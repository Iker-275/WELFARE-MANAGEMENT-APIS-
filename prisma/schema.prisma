generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model OTP {
  id         String    @id @default(uuid())
  userId     String
  codeHash   String
  type       OtpType
  expiresAt  DateTime
  verifiedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otps")
}

model Region {
  id                  String               @id @default(uuid())
  name                String               @unique
  code                String?              @unique
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  announcementTargets AnnouncementRegion[]
  notificationTargets NotificationRegion[]
  users               User[]

  @@map("regions")
}

model Role {
  id                String             @id @default(uuid())
  name              String             @unique
  description       String?
  isNecRole         Boolean            @default(false)
  isSystem          Boolean            @default(false)
  termYears         Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  announcementRoles AnnouncementRole[]
  notificationRoles NotificationRole[]
  permissions       RolePermission[]
  userRoleHistories UserRoleHistory[]
  users             User[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model MembershipFine {
  id        String    @id @default(uuid())
  userId    String
  amount    Decimal   @db.Decimal(18, 2)
  reason    String
  issuedAt  DateTime  @default(now())
  dueDate   DateTime?
  paid      Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("membership_fines")
}

model AGMAttendance {
  id        String   @id @default(uuid())
  userId    String
  year      Int
  attended  Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([year])
  @@map("agm_attendances")
}

model MembershipStatusHistory {
  id          String           @id @default(uuid())
  userId      String
  oldStatus   MembershipStatus
  newStatus   MembershipStatus
  reason      String?
  changedById String?
  changedAt   DateTime         @default(now())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("membership_status_histories")
}

model ContributionType {
  id               String              @id @default(uuid())
  name             String              @unique
  description      String?
  isRecurring      Boolean             @default(false)
  recurrencePeriod ContributionPeriod?
  defaultAmount    Decimal?            @db.Decimal(18, 2)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  contributions    Contribution[]

  @@map("contribution_types")
}

model Contribution {
  id                 String             @id @default(uuid())
  userId             String
  contributionTypeId String
  amount             Decimal            @db.Decimal(18, 2)
  penaltyAmount      Decimal?           @db.Decimal(18, 2)
  totalAmount        Decimal?           @db.Decimal(18, 2)
  paidAmount         Decimal?           @db.Decimal(18, 2)
  balanceAmount      Decimal?           @db.Decimal(18, 2)
  dueDate            DateTime?
  paidAt             DateTime?
  status             ContributionStatus @default(pending)
  receiptNumber      String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  contributionType   ContributionType   @relation(fields: [contributionTypeId], references: [id])
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@map("contributions")
}

model User {
  id                      String                    @id @default(uuid())
  employeeId              String?                   @unique
  membershipNumber        String?                   @unique
  nationalId              String?                   @unique
  firstName               String?
  lastName                String?
  otherNames              String?
  gender                  Gender?
  dateOfBirth             DateTime?
  email                   String?                   @unique
  phone                   String?                   @unique
  address                 String?
  passwordHash            String
  isEmailVerified         Boolean                   @default(false)
  isPhoneVerified         Boolean                   @default(false)
  emailVerifiedAt         DateTime?
  failedLoginAttempts     Int                       @default(0)
  lockedUntil             DateTime?
  passwordChangedAt       DateTime?
  lastLoginAt             DateTime?
  lastActivityAt          DateTime?
  membershipStatus        MembershipStatus          @default(active)
  employmentStatus        EmploymentStatus          @default(serving)
  joinedDate              DateTime?
  employmentStartDate     DateTime?
  membershipApprovedAt    DateTime?
  membershipEndedAt       DateTime?
  isNecMember             Boolean                   @default(false)
  eligibleForElection     Boolean                   @default(false)
  signupCompleted         Boolean                   @default(false)
  isActive                Boolean                   @default(true)
  createdById             String?
  updatedById             String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  roleId                  String?
  regionId                String?
  profilePhotoId          String?
  deactivatedAt           DateTime?
  deactivatedById         String?
  deactivationReason      String?
  revokedAt               DateTime?
  suspendedAt             DateTime?
  suspendedUntil          DateTime?
  agmAttendances          AGMAttendance[]
  announcementRecipients  AnnouncementRecipient[]
  createdAnnouncements    Announcement[]
  affectedAuditEvents     AuditEvent[]              @relation("AuditAffectedUser")
  performedAuditEvents    AuditEvent[]              @relation("AuditPerformedBy")
  auditEvents             AuditEvent[]
  contributions           Contribution[]
  dependants              Dependant[]
  uploadedFiles           FileUpload[]
  createdImportJobs       ImportJob[]
  loginActivities         LoginActivity[]
  membershipFines         MembershipFine[]
  membershipStatusHistory MembershipStatusHistory[]
  nextOfKin               NextOfKin?
  notificationRecipients  NotificationRecipient[]
  createdNotifications    Notification[]
  otps                    OTP[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  roleHistoryRecorded     UserRoleHistory[]         @relation("RoleHistoryRecordedBy")
  userRoleHistories       UserRoleHistory[]
  createdBy               User?                     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers            User[]                    @relation("UserCreatedBy")
  deactivatedBy           User?                     @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedUsers        User[]                    @relation("UserDeactivatedBy")
  profilePhoto            FileUpload?               @relation("ProfilePhoto", fields: [profilePhotoId], references: [id])
  region                  Region?                   @relation(fields: [regionId], references: [id])
  role                    Role?                     @relation(fields: [roleId], references: [id])
  updatedBy               User?                     @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  updatedUsers            User[]                    @relation("UserUpdatedBy")
  welfareClaims           WelfareClaim[]

  @@index([email])
  @@index([employmentStatus])
  @@index([isActive])
  @@index([isNecMember])
  @@index([eligibleForElection])
  @@index([createdAt])
  @@index([firstName])
  @@index([lastName])
  @@index([roleId])
  @@index([regionId])
  @@index([membershipStatus])
  @@index([employeeId])
  @@index([membershipNumber])
  @@map("users")
}

model UserRoleHistory {
  id            String    @id @default(uuid())
  userId        String
  roleId        String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?
  recordedById  String?
  createdAt     DateTime  @default(now())
  recordedBy    User?     @relation("RoleHistoryRecordedBy", fields: [recordedById], references: [id])
  role          Role      @relation(fields: [roleId], references: [id])
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_role_histories")
}

model NextOfKin {
  id               String   @id @default(uuid())
  userId           String   @unique
  fullName         String
  relationship     String
  phone            String?
  nationalId       String?
  address          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  alternativePhone String?
  email            String?
  isPrimary        Boolean  @default(true)
  occupation       String?
  remarks          String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nationalId])
  @@map("next_of_kin")
}

model Dependant {
  id                  String    @id @default(uuid())
  userId              String
  fullName            String
  relationship        String
  dateOfBirth         DateTime?
  birthNotificationNo String?
  nationalId          String?
  burialPermitNo      String?
  isActive            Boolean   @default(true)
  deathDate           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dependants")
}

model FileUpload {
  id                String         @id @default(uuid())
  originalName      String
  fileName          String
  mimeType          String
  extension         String?
  size              Int
  storageProvider   String?
  storagePath       String
  publicUrl         String?
  category          FileCategory
  visibility        FileVisibility @default(private)
  uploadedById      String
  checksum          String?
  isMalwareScanned  Boolean        @default(false)
  malwareScanStatus String?
  metadata          Json?
  uploadedViaImport Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  isDeleted         Boolean        @default(false)
  uploadedBy        User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  importJobs        ImportJob[]
  profilePhotoUsers User[]         @relation("ProfilePhoto")

  @@index([uploadedById])
  @@index([category])
  @@map("file_uploads")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model LoginActivity {
  id            String   @id @default(uuid())
  userId        String
  ipAddress     String?
  userAgent     String?
  loginAt       DateTime @default(now())
  success       Boolean  @default(true)
  failureReason String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_activities")
}

model AuditEvent {
  id             String        @id @default(uuid())
  userId         String?
  action         String
  entityType     String
  entityId       String?
  description    String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  affectedUserId String?
  endpoint       String?
  metadata       Json?
  method         String?
  module         String?
  performedById  String?
  requestId      String?
  severity       AuditSeverity @default(info)
  status         AuditStatus   @default(success)
  affectedUser   User?         @relation("AuditAffectedUser", fields: [affectedUserId], references: [id])
  performedBy    User?         @relation("AuditPerformedBy", fields: [performedById], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([performedById])
  @@index([affectedUserId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([module])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@map("audit_events")
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  refreshToken   String    @unique
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revoked        Boolean   @default(false)
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Notification {
  id            String                  @id @default(uuid())
  title         String
  message       String
  type          String?
  sendToAll     Boolean                 @default(false)
  metadata      Json?
  createdById   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  recipients    NotificationRecipient[]
  targetRegions NotificationRegion[]
  targetRoles   NotificationRole[]
  createdBy     User?                   @relation(fields: [createdById], references: [id])

  @@map("notifications")
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
  @@map("notification_recipients")
}

model NotificationRole {
  id             String       @id @default(uuid())
  notificationId String
  roleId         String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([notificationId, roleId])
  @@map("notification_roles")
}

model NotificationRegion {
  id             String       @id @default(uuid())
  notificationId String
  regionId       String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  region         Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([notificationId, regionId])
  @@map("notification_regions")
}

model AnnouncementRegion {
  id             String       @id @default(uuid())
  announcementId String
  regionId       String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  region         Region       @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([announcementId, regionId])
  @@map("announcement_regions")
}

model Announcement {
  id            String                  @id @default(uuid())
  title         String
  content       String
  sendToAll     Boolean                 @default(false)
  isPublished   Boolean                 @default(false)
  publishedAt   DateTime?
  expiresAt     DateTime?
  attachments   Json?
  createdById   String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  recipients    AnnouncementRecipient[]
  targetRegions AnnouncementRegion[]
  targetRoles   AnnouncementRole[]
  createdBy     User                    @relation(fields: [createdById], references: [id])

  @@map("announcements")
}

model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_recipients")
}

model AnnouncementRole {
  id             String       @id @default(uuid())
  announcementId String
  roleId         String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([announcementId, roleId])
  @@map("announcement_roles")
}

model WelfareClaim {
  id        String   @id @default(uuid())
  userId    String
  claimType String
  status    String   @default("submitted")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@map("welfare_claims")
}

model ImportJob {
  id                String           @id @default(uuid())
  type              ImportType
  fileId            String
  status            ImportStatus     @default(pending)
  totalRecords      Int?
  processedRecords  Int?
  failedRecords     Int?
  errorReport       Json?
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?
  queueJobId        String?
  startedAt         DateTime?
  successfulRecords Int?
  errors            ImportJobError[]
  createdBy         User             @relation(fields: [createdById], references: [id])
  file              FileUpload       @relation(fields: [fileId], references: [id])

  @@index([fileId])
  @@index([createdById])
  @@index([status])
  @@map("import_jobs")
}

model ImportJobError {
  id          String    @id @default(uuid())
  importJobId String
  rowNumber   Int
  error       String
  rowData     Json?
  createdAt   DateTime  @default(now())
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
  @@map("import_job_errors")
}

enum MembershipStatus {
  active
  inactive
  suspended
  revoked
  deceased
  resigned
  pending
}

enum ContributionStatus {
  pending
  partial
  paid
  overdue
  waived
}

enum ContributionPeriod {
  monthly
  quarterly
  yearly
}

enum Gender {
  male
  female
  other
}

enum AuditSeverity {
  info
  warning
  critical
}

enum AuditStatus {
  success
  failed
}

enum EmploymentStatus {
  serving
  retired
  former
}

enum FileCategory {
  profile_photo
  national_id
  next_of_kin_document
  dependant_document
  claim_document
  meeting_document
  audit_document
  constitution_document
  receipt
  other
}

enum FileVisibility {
  private
  restricted
  public
}

enum OtpType {
  email_verification
  forgot_password
  login_verification
}

enum ImportType {
  users
  dependants
  next_of_kin
  contributions
  agm_attendance
}

enum ImportStatus {
  pending
  processing
  completed
  failed
}
